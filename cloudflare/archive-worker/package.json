{
  "name": "awsl-chat-archive",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "node --check src/index.js && wrangler deploy --dry-run",
    "test": "node --test test/archive.test.mjs",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": { "wrangler": "4.156.0" }
}
