# AWSL 微信机器人配置文件
# 复制此文件为 .env 并填入实际值

# 群聊名称
GROUP_NAME=PY 交易群·小米红米·安卓机

# 触发关键词
TRIGGER_KEYWORD=awsl

# 检查消息间隔（秒）
CHECK_INTERVAL=3

# 触发冷却时间（秒）
TRIGGER_COOLDOWN=10

# 命令 API 地址
COMMAND_API_BASE_URL=https://your-api-domain.com/api

# OpenAI API 配置（必填）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# HTTP API 服务配置
HTTP_API_ENABLED=true
HTTP_API_HOST=0.0.0.0
HTTP_API_PORT=8000
HTTP_API_TOKEN=your-secret-token-here  # Bearer Token 认证，留空则不启用认证
HTTP_API_BASE_URL=http://localhost:8000  # 内部回调地址（用于群聊总结等异步任务）

# 机器人名称（@BOT_NAME 触发 AI 回复）
BOT_NAME=

# 微信数据库解密/总结配置（可选，用于聊天记录查询和群聊总结功能）
WECHAT_DB_INPUT_PATH=   # 加密数据库输入目录
WECHAT_DB_OUTPUT_PATH=  # 解密后输出目录
WECHAT_DB_KEY=          # 数据库解密密钥
