# AWSL 微信机器人配置文件
# 复制此文件为 .env 并填入实际值

# 触发关键词
TRIGGER_KEYWORD=awsl

# 检查消息间隔（秒）
CHECK_INTERVAL=3

# 触发限速 - 每个窗口每分钟最多触发次数
TRIGGER_RATE_LIMIT=10
TRIGGER_RATE_WINDOW=60

# Windows 语音发送（LocalAI 优先、EdgeTTS 回退 -> VB-CABLE；Linux 暂不支持）
LOCALAI_TTS_API_URL=https://local-ai.example.com/v1/audio/speech
LOCALAI_TTS_API_KEY=your-localai-api-key
LOCALAI_TTS_MODEL=qwen3-tts-cpp-customvoice-q4
LOCALAI_TTS_VOICE=Serena
LOCALAI_TTS_TIMEOUT=180
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
WINDOWS_VOICE_PLAYBACK_DEVICE=Speakers (VB-Audio Virtual Cable)
WINDOWS_VOICE_RECORDING_DEVICE=CABLE Output (VB-Audio Virtual Cable)
WINDOWS_VOICE_SAMPLE_RATE=48000
WINDOWS_VOICE_MAX_TEXT_LENGTH=1000
WINDOWS_VOICE_MAX_FILE_BYTES=7000000
WINDOWS_VOICE_MAX_DURATION=60
WINDOWS_VOICE_TIMEOUT=90

# 远程命令（COMMAND_API）；不配置 COMMAND_API_BASE_URL 等同关闭远程命令
REMOTE_COMMANDS_ENABLED=true
COMMAND_API_BASE_URL=

# OpenAI API 配置（必填）
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
SUMMARY_LLM_TIMEOUT=180
# 群聊总结 HTML 截图浏览器; 不自动探测或回退
BROWSER_EXECUTABLE=

# Gateway 服务配置
HTTP_API_HOST=0.0.0.0
HTTP_API_PORT=8000
HTTP_API_TOKEN=your-secret-token-here  # Bearer Token 认证，留空则不启用认证
HTTP_API_BASE_URL=http://localhost:8000  # 内部回调地址（用于群聊总结等异步任务）

# Cortex 服务配置
CORTEX_HTTP_HOST=0.0.0.0
CORTEX_HTTP_PORT=7999
CORTEX_POOL_SIZE=4
CORTEX_QUEUE_SIZE=100

# Chatlog 服务配置（独立服务，提供微信数据库解密/查询）
CHATLOG_HTTP_HOST=0.0.0.0
CHATLOG_HTTP_PORT=7998
# /api/chatlog/* 默认走 v2（原生库在线读取，Windows/Linux）；设为 false 切到 v1（pycryptodome 离线解密）
# /api/chatlog/v1/* 和 /api/chatlog/v2/* 始终对应各自实现
CHATLOG_USE_V2=true

# 机器人名称列表（@名称 触发 AI 回复，逗号分隔，支持多个）
BOT_NAMES=["机器人","小助手"]

# 微信数据库解密/总结配置（可选，用于聊天记录查询和群聊总结功能）
# Linux 可填具体 db_storage；如果填 xwechat_files 根目录且有多个账号，会选最近修改的 db_storage
WECHAT_DB_INPUT_PATH=   # 加密数据库输入目录
WECHAT_DB_OUTPUT_PATH=  # v1 解密后输出目录；v2 不需要
WECHAT_DB_KEY=          # Windows: 64位密钥；Linux: per-db 密钥 JSON：{"contact/contact.db":"64hex","message/message_0.db":"64hex"}

# 微信图片 V2 .dat 解密密钥（可选），由 tools/extract_wx_image_key_*.py 派生（无需读进程内存）
IMAGE_AES_KEY=          # 16 字节 ASCII（hex 字符串）
IMAGE_XOR_KEY=0x88      # XOR 字节，默认 0x88，实际值由脚本从 _t.dat 末字节投票推导

# 表情本地缓存（cache/<YYYY-MM>/Emoticon）解密密钥：AES-128-CBC(iv=key) 全局密钥。
# 默认用 config.py 内置值（微信 4.x 通用）；个别版本不同时取消下行注释覆盖（32 位 hex）
# EMOTICON_AES_KEY=4e514cb9da6282d0f70de78089c43f6c

# Linux Gateway 通过 X11 发送、通过 chatlog 读取消息
LINUX_WECHAT_DISPLAY=:10
LINUX_WECHAT_XAUTHORITY=~/.Xauthority
LINUX_CHATLOG_MESSAGE_LIMIT=20
LINUX_CHATLOG_GROUP_CACHE_TTL=30

# Daemon 控制器配置（可选，用于远程管理 bot 启停和代码更新）
DAEMON_PORT=8001
DAEMON_HOST=0.0.0.0
DAEMON_RESTART_DELAY=5
DAEMON_MAX_RETRIES=10
DAEMON_LOG_BUFFER_LINES=5000

# Webhook 配置（可选）
WEBHOOK_POOL_SIZE=5
WEBHOOK_QUEUE_SIZE=100
WEBHOOK_TIMEOUT=10
WEBHOOK_REPLY_TIMEOUT=180

# 发送配置（可选）
SEND_QUEUE_SIZE=100
